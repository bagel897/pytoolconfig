{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "tests/**"],
  "pre-commit": {
    "enabled": true
  },
  "constraints": {
    "python": "3.14"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
